{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "BMO: Fast Check (< 15 s)",
      "type": "shell",
      "command": "python tasks.py check --fast",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "BMO: Full Check",
      "type": "shell",
      "command": "python tasks.py check",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "BMO: Build Default Firmware (ESP32-S3)",
      "type": "shell",
      "command": "python tasks.py build --profile default --warnings strict --fail-on-warnings",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc"
    },
    {
      "label": "BMO: Build All Profiles (default, no-doom, mit)",
      "type": "shell",
      "command": "python tasks.py build --profile all --warnings strict --fail-on-warnings",
      "group": "build",
      "problemMatcher": "$gcc"
    },
    {
      "label": "BMO: Memory Size & Budget Report",
      "type": "shell",
      "command": "python tasks.py size --check-budgets",
      "problemMatcher": []
    },
    {
      "label": "BMO: Environment Doctor",
      "type": "shell",
      "command": "python tasks.py doctor",
      "problemMatcher": []
    }
  ]
}
