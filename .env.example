# BMO Handheld Developer Environment Variables (copy to .env if needed; never commit .env)

# Optional external directory containing user-owned roms/ and games/ (never committed to repo).
# Defaults to repository root when unset.
BMO_DATA_DIR=

# Path to WASI SDK 34 root for compiling host WASM tests and simulator browser cores.
# Defaults to .tools/wasi-sdk-34.0-x86_64-windows when present.
WASI_SDK_PATH=

# Custom Arduino CLI data directory containing esp32:esp32@3.3.11 toolchain binaries.
ARDUINO_DIRECTORIES_DATA=

# Set to 1 to make `scripts/validate_repo.py` fail when arduino-cli target compile cannot run.
BMO_REQUIRE_TARGET_COMPILE=0

# Optional host C/C++ compiler overrides for CMake CTest / ASan builds.
CC=
CXX=
