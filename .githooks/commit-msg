#!/bin/sh
# Enforce Conventional Commits: type(optional-scope): subject (and allow Merge / Revert commits).

MSG_FILE="$1"
python - "$MSG_FILE" <<'PYEOF'
import pathlib
import re
import sys

lines = pathlib.Path(sys.argv[1]).read_text(encoding="utf-8", errors="ignore").splitlines()
meaningful = [line.strip() for line in lines if line.strip() and not line.lstrip().startswith("#")]
if not meaningful:
    print("[commit-msg] ERROR: empty commit message.")
    sys.exit(1)

subject = meaningful[0]
pattern = re.compile(
    r"^(?:Merge\b|Revert\b|(?:feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(?:\([a-zA-Z0-9_./-]+\))?!?: \S.*)"
)
if not pattern.match(subject):
    print(f"[commit-msg] ERROR: subject '{subject}' does not match Conventional Commits:")
    print("  Expected: <type>(<scope>): <subject>  (e.g. 'fix(storage): validate BSS2 header CRC')")
    print("  Allowed types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert")
    sys.exit(1)
PYEOF
